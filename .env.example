# ------------------------------------------------------------------
# back-lesson API — muhit o'zgaruvchilari namunasi
#
# Foydalanish:
#   cp .env.example .env
# so'ng quyidagi qiymatlarni o'zingiznikiga almashtiring.
#
# .env fayli .gitignore da — u repozitoriyga tushmaydi.
# ------------------------------------------------------------------

# Server tinglaydigan port (ixtiyoriy, default: 3002)
PORT=3002

# Tinglash manzili (ixtiyoriy, default: 0.0.0.0 — lokal tarmoqdan ham ochiladi)
HOST=0.0.0.0

# development | production | test   (test bo'lsa morgan loglari o'chadi)
NODE_ENV=development

# MongoDB ulanish satri — MAJBURIY
# Atlas:  mongodb+srv://<user>:<parol>@<cluster>.mongodb.net/<baza>
# Lokal:  mongodb://127.0.0.1:27017/back-lesson
MONGO_URI=

# Cloudinary kalitlari — MAJBURIY
# https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rasmlar saqlanadigan papka (ixtiyoriy, default: back-lesson)
CLOUDINARY_FOLDER=back-lesson
